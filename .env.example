# Copy this file to .env.local and fill in real values — .env.local is gitignored, .env.example
# is committed as documentation only.

# From sanity.io → your project → Settings → API (or `npx sanity@latest init` creates these
# for you). Public: safe to expose in the browser, that's how the Studio and the site's own
# reads know which project/dataset to hit.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed to run `npm run seed` (one-time initial content import) — a token with **Editor**
# (write) access, from Sanity dashboard → API → Tokens. Never commit this; in Vercel it isn't
# needed at all (the deployed site only *reads* from Sanity).
SANITY_API_TOKEN=

# A secret you invent yourself (any random string) — set the same value in Sanity's webhook
# config (Settings → API → Webhooks → this project's webhook → Secret) and in Vercel's env vars.
# Without it, /api/revalidate would accept a POST from anyone claiming to be Sanity.
SANITY_REVALIDATE_SECRET=

# Your real deployed domain (e.g. https://khabarov.dev or the vercel.app one) — used for the
# sitemap, robots.txt, and Open Graph/canonical URLs. Falls back to a placeholder if unset, so
# it's fine to leave blank locally; set it for real once you have a domain, in Vercel's env vars.
NEXT_PUBLIC_SITE_URL=
